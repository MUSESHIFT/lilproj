# money rundown — environment
# copy this file to .env and fill in real values. never commit .env.

# --- google oauth (gmail api, read-only) ---
# from google cloud console → apis & services → credentials → oauth 2.0 client id
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# must match an authorized redirect uri on the oauth client, exactly.
GOOGLE_REDIRECT_URI=https://rundown.museshift.com/api/auth/google/callback

# --- encryption ---
# encrypts stored gmail tokens at rest. must be 32 bytes as 64 hex chars.
# generate once with:  openssl rand -hex 32
MR_ENCRYPTION_KEY=

# --- outbound email (the weekly digest) ---
# free gmail smtp. SMTP_PASS is a gmail app password, NOT your login password.
# create one at: google account → security → 2-step verification → app passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
# the from line on the digest. usually the same gmail address.
MAIL_FROM=money rundown <you@gmail.com>

# --- runtime ---
NODE_ENV=production
# public base url the app is served from (used for links + oauth).
APP_BASE_URL=https://rundown.museshift.com
